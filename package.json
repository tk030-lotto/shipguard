{
  "name": "shipguard",
  "version": "0.1.0",
  "description": "Pre-launch security and configuration audit CLI for indie hackers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "shipguard": "bin/shipguard.js"
  },
  "type": "module",
  "files": [
    "dist",
    "bin",
    "schema.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "audit",
    "pre-launch",
    "cli",
    "secrets",
    "rls",
    "indie-hacker"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ignore": "^6.0.2",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
